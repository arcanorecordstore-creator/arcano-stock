# API key de Anthropic (para los modos "Desde screenshot" y "Desde factura")
# Sacar en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Servidor Flask
FLASK_PORT=5001
FLASK_DEBUG=false
# Si queres acceder a la app desde tu celular en la misma red wifi,
# poner 0.0.0.0 (por defecto solo escucha en localhost).
# FLASK_HOST=0.0.0.0

# Credenciales del admin (FASE 2)
# Si comentas estas dos lineas, el admin queda sin login (modo dev local).
# Para activar login, descomenta y elegi tu usuario y contrasenia:
# ADMIN_USER=facundo
# ADMIN_PASS=cambiame_por_algo_seguro

# Email para notificaciones de reserva (se configura en Fase 2.4)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_email@gmail.com
# SMTP_PASS=tu_app_password_de_gmail
# SMTP_FROM=tu_email@gmail.com
# SMTP_TO=tu_email@gmail.com

# Mercado Pago (queda APAGADO hasta que prendas el toggle en Ajustes).
# MP_ACCESS_TOKEN: el Access Token de tu cuenta MP (TEST-... = sandbox).
# MP_WEBHOOK_SECRET: la "clave secreta" del webhook (panel de MP > Webhooks).
#   Si esta cargada, se valida la firma de cada aviso de pago.
# MP_ACCESS_TOKEN=TEST-...
# MP_WEBHOOK_SECRET=...
